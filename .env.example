# ========================================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Server Environment
PORT=10000
NODE_ENV=production

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mrsam_driving_school?retryWrites=true&w=majority

# Authentication Security (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRES_IN=7d
ADMIN_SECRET_KEY=your_admin_onboarding_secret_key

# Frontend Allowed Origin (Your deployed Vercel domain)
FRONTEND_URL=https://your-project-name.vercel.app

# Business Contact Information
INSTRUCTOR_NAME="Sam"
PHONE_NUMBER="+44 7473 958802"
WHATSAPP_NUMBER="447473958802"
EMAIL="contact@samsdrivingschool.co.uk"

# Custom Domain SMTP Email Configuration (Optional - for candidate notifications)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
